---
import Icon from './Icon.astro';
import { profile } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const path = Astro.url.pathname.replace(/\/?$/, '/');

const nav = [
  { href: `${base}projects/`, label: 'Projects' },
  { href: `${base}about/`, label: 'About' },
  { href: `${base}#contact`, label: 'Contact' },
];
---

<header class="header">
  <div class="container inner">
    <a class="brand" href={base}>
      <span class="full">{profile.shortName}</span>
      <span class="mono" aria-hidden="true">DB</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="cv" href={`${base}${profile.cvFile}`} download><Icon name="download" /> CV</a>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <span class="sun"><Icon name="sun" /></span>
      <span class="moon"><Icon name="moon" /></span>
    </button>
  </div>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === 'dark'
      : window.matchMedia('(prefers-color-scheme: dark)').matches;

  button?.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 3.75rem;
  }

  .brand {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }

  .mono {
    display: none;
  }

  @media (max-width: 420px) {
    .full {
      display: none;
    }
    .mono {
      display: inline;
    }
  }

  nav {
    margin-left: auto;
  }

  nav ul {
    display: flex;
    gap: clamp(0.75rem, 3vw, 1.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--muted);
    font-size: 0.9rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .cv {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .cv :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    flex-shrink: 0;
  }

  .theme-toggle :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .sun {
    display: contents;
  }
  :global(:root[data-theme='dark']) .moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .sun {
      display: contents;
    }
    :global(:root:not([data-theme='light'])) .moon {
      display: none;
    }
  }
</style>
