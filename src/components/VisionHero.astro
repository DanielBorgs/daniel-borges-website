---
// Hero visual: stage photos "analysed" by a vision model — a scan line reveals
// each photo, then detection boxes draw in, CVAT/YOLO style. Boxes are
// hand-annotated in src/data/cv.ts (stagePhotos). Pure CSS + ~30 lines of JS.
import { stagePhotos } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const src = (name: string, w: number) => `${base}images/${name}-${w}.webp`;
---

<figure class="vision" aria-label="Photos of Daniel on stage at JunctionX Lisbon 2026, with animated object-detection boxes">
  <div class="frame">
    {
      stagePhotos.map((p, i) => (
        <div class:list={['shot', { active: i === 0 }]} data-count={p.boxes.length}>
          <img
            src={src(p.name, 960)}
            srcset={`${src(p.name, 480)} 480w, ${src(p.name, 960)} 960w`}
            sizes="(min-width: 900px) 420px, 90vw"
            width="960"
            height="1200"
            alt={p.alt}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            decoding="async"
          />
          <div class="boxes" aria-hidden="true">
            {p.boxes.map((b, j) => (
              <div
                class:list={['det', b.kind ?? 'part', b.labelAt && `label-${b.labelAt}`, { 'label-end': b.box[2] > 80 }]}
                style={`--l:${b.box[0]}%;--t:${b.box[1]}%;--w:${b.box[2] - b.box[0]}%;--h:${b.box[3] - b.box[1]}%;--d:${j}`}
              >
                <span>
                  {b.label} <b>{b.score.toFixed(2)}</b>
                </span>
              </div>
            ))}
          </div>
        </div>
      ))
    }
    <div class="scan" aria-hidden="true"></div>
  </div>

  <figcaption class="hud">
    <span class="live" aria-hidden="true"></span>
    <span class="status">detecting</span>
    <span class="sep" aria-hidden="true">·</span>
    <span>JunctionX Lisbon 2026</span>
    <span class="pips" aria-hidden="true">
      {stagePhotos.map((_, i) => <i class:list={{ on: i === 0 }} />)}
    </span>
  </figcaption>
</figure>

<script>
  const root = document.querySelector<HTMLElement>('.vision');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && !reduce) {
    const shots = [...root.querySelectorAll<HTMLElement>('.shot')];
    const pips = [...root.querySelectorAll<HTMLElement>('.pips i')];
    const status = root.querySelector<HTMLElement>('.status')!;
    const scan = root.querySelector<HTMLElement>('.scan')!;
    let i = 0;
    let visible = true;

    const label = () => {
      status.textContent = 'detecting';
      window.setTimeout(() => (status.textContent = `${shots[i].dataset.count} objects`), 1600);
    };

    const show = (next: number) => {
      shots.forEach((s) => s.classList.remove('prev'));
      shots[i].classList.replace('active', 'prev');
      i = next;
      // restart CSS animations
      shots[i].classList.remove('active');
      scan.classList.remove('run');
      void shots[i].offsetWidth;
      shots[i].classList.add('active');
      scan.classList.add('run');
      pips.forEach((p, k) => p.classList.toggle('on', k === i));
      label();
    };

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(root);
    scan.classList.add('run');
    label();
    window.setInterval(() => {
      if (visible && !document.hidden) show((i + 1) % shots.length);
    }, 6000);
  } else if (root) {
    root.classList.add('static');
    const first = root.querySelector<HTMLElement>('.shot');
    root.querySelector<HTMLElement>('.status')!.textContent = `${first?.dataset.count} objects`;
  }
</script>

<style>
  .vision {
    --det: #5eead4;
    --det-part: #fcd34d;
    margin: 0;
    width: 100%;
    max-width: 26rem;
    justify-self: center;
  }

  @media (max-width: 899px) {
    .vision {
      max-width: 22rem;
    }
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    background: #0d0f12;
    box-shadow:
      0 0 0 1px var(--line),
      0 30px 60px -30px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  /* faint pixel grid, like an annotation canvas */
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(255 255 255 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
    pointer-events: none;
    z-index: 3;
  }

  .shot {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .shot.prev {
    opacity: 1;
    z-index: 1;
  }

  .shot.active {
    opacity: 1;
    z-index: 2;
    animation: reveal 1.2s cubic-bezier(0.6, 0, 0.3, 1) both;
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .shot.active img {
    animation: focus 1.6s ease-out both;
  }

  @keyframes reveal {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes focus {
    from {
      filter: saturate(0.2) contrast(1.15) brightness(0.85);
    }
    to {
      filter: none;
    }
  }

  .scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    z-index: 4;
    background: var(--det);
    box-shadow:
      0 0 12px 2px var(--det),
      0 0 40px 8px color-mix(in srgb, var(--det) 35%, transparent);
    opacity: 0;
  }

  .scan.run {
    animation: scan 1.2s cubic-bezier(0.6, 0, 0.3, 1) both;
  }

  @keyframes scan {
    0% {
      top: 0;
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  .boxes {
    position: absolute;
    inset: 0;
  }

  .det {
    position: absolute;
    left: var(--l);
    top: var(--t);
    width: var(--w);
    height: var(--h);
    border: 1.5px solid var(--c);
    border-radius: 3px;
    background: color-mix(in srgb, var(--c) 8%, transparent);
    opacity: 0;
    --c: var(--det-part);
  }

  .det.main {
    --c: var(--det);
    border-width: 2px;
    background: color-mix(in srgb, var(--c) 5%, transparent);
  }

  .shot.active .det {
    animation: draw 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) calc(1.1s + var(--d) * 0.22s) both;
  }

  .vision.static .det {
    opacity: 1;
  }

  @keyframes draw {
    from {
      opacity: 0;
      transform: scale(1.12);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .det span {
    position: absolute;
    left: -1.5px;
    bottom: 100%;
    margin-bottom: 2px;
    padding: 1px 5px;
    border-radius: 3px;
    background: var(--c);
    color: #0b0c0e;
    font: 600 10px/1.4 ui-monospace, 'Cascadia Code', 'SF Mono', Consolas, monospace;
    white-space: nowrap;
  }

  /* the big "person" box labels itself inside, bottom-left, clear of the face/mic labels */
  .det.main span {
    bottom: 6px;
    left: 6px;
    margin: 0;
  }

  /* boxes touching the right edge align their label to the right so it isn't clipped */
  .det.label-end span {
    left: auto;
    right: -1.5px;
  }

  .det.label-bottom span {
    bottom: auto;
    top: 100%;
    margin: 2px 0 0;
  }

  .det.label-right span {
    bottom: auto;
    left: 100%;
    top: -1.5px;
    margin: 0 0 0 3px;
  }

  .det span b {
    font-weight: 400;
    opacity: 0.75;
  }

  .hud {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.85rem;
    color: var(--muted);
    font: 500 0.75rem/1 ui-monospace, 'Cascadia Code', 'SF Mono', Consolas, monospace;
  }

  .status {
    color: var(--text);
    min-width: 5.5rem;
  }

  .live {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #2e9d5b;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  .pips {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }

  .pips i {
    width: 14px;
    height: 3px;
    border-radius: 2px;
    background: var(--line);
    transition: background 0.3s;
  }

  .pips i.on {
    background: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .live,
    .shot.active,
    .shot.active img,
    .shot.active .det {
      animation: none;
    }
    .det {
      opacity: 1;
    }
  }
</style>
