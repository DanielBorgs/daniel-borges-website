---
import Icon from './Icon.astro';
import type { Entry } from '../data/cv';

interface Props {
  entry: Entry;
  /** Short form: header + one-line summary + link to the full entry */
  compact?: boolean;
  detailsHref?: string;
}
const { entry, compact = false, detailsHref } = Astro.props;
---

<article class:list={['card', { compact }]} id={compact ? undefined : entry.id}>
  <header>
    <div class="titles">
      <p class="org">
        {entry.org}
        {entry.location && <span class="loc"> · {entry.location}</span>}
      </p>
      {
        entry.roles ? (
          <ul class="roles">
            {entry.roles.map((r) => (
              <li>
                <h3>{r.title}</h3>
                <span class="period">{r.period}</span>
              </li>
            ))}
          </ul>
        ) : (
          <h3>
            {entry.title}
            {entry.badge && <span class="badge">{entry.badge}</span>}
          </h3>
        )
      }
    </div>
    {!entry.roles && <p class="period">{entry.period}</p>}
  </header>

  {
    compact ? (
      <p class="summary">
        {entry.summary}
        {detailsHref && (
          <a class="details" href={detailsHref}>
            Details <Icon name="arrow" />
          </a>
        )}
      </p>
    ) : (
      <ul class="bullets">
        {entry.bullets.map((b) => <li>{b}</li>)}
      </ul>
    )
  }

  {
    !compact && Boolean(entry.tags?.length || entry.links?.length) && (
      <footer>
        {entry.tags && (
          <ul class="tags" aria-label="Technologies">
            {entry.tags.map((t) => <li>{t}</li>)}
          </ul>
        )}
        {entry.links && (
          <ul class="links">
            {entry.links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer">
                  {l.label}
                  <Icon name="external" />
                </a>
              </li>
            ))}
          </ul>
        )}
      </footer>
    )
  }
</article>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
  }

  .card.compact {
    padding: 1rem 1.5rem;
    background: transparent;
  }

  .compact header {
    margin-bottom: 0.4rem;
  }

  .compact h3 {
    font-size: 1rem;
  }

  .summary {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .details {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: 0.4rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .details :global(svg) {
    width: 0.85rem;
    height: 0.85rem;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.9rem;
  }

  .org {
    color: var(--accent);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .loc {
    color: var(--muted);
    font-weight: 400;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .badge {
    display: inline-block;
    vertical-align: 0.15em;
    margin-left: 0.5rem;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: var(--badge-soft);
    color: var(--badge);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .period {
    color: var(--muted);
    font-size: 0.85rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .roles {
    list-style: none;
    margin: 0.15rem 0 0;
    padding: 0;
  }

  .roles li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.75rem;
  }

  .bullets {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
    font-size: 0.95rem;
  }

  .bullets li::marker {
    color: var(--muted);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }

  .tags,
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--text);
    font-size: 0.78rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .links :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
  }
</style>
