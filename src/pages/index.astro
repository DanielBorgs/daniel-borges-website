---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import EntryCard from '../components/EntryCard.astro';
import Icon from '../components/Icon.astro';
import VisionHero from '../components/VisionHero.astro';
import { profile, openTo, highlights, experience, research, projects, leadership, education, skills } from '../data/cv';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const featured = [...research, ...projects].filter((e) => e.featured);
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="intro">
        <p class="eyebrow"><Icon name="pin" /> {profile.location}</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role} <span>· {profile.focus}</span></p>
        <p class="pitch">{profile.pitch}</p>

        <ul class="open" aria-label="Open to">
          <li><Icon name="clock" /> {openTo[0].short}</li>
          <li><Icon name="globe" /> {openTo[1].short}</li>
        </ul>

        <div class="actions">
          <a class="btn primary" href={`mailto:${profile.email}`}><Icon name="mail" /> Email me</a>
          <a class="btn" href={`${base}${profile.cvFile}`} download><Icon name="download" /> <span><span class="wide">Download </span>CV</span></a>
          <a class="btn icon" href={profile.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="linkedin" /></a>
          <a class="btn icon" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><Icon name="github" /></a>
        </div>
      </div>

      <VisionHero />
    </div>

    <div class="container">
      <dl class="highlights">
        {
          highlights.map((h) => (
            <div>
              <dt>{h.label}</dt>
              <dd>{h.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <Section id="experience" title="Experience" kicker="Industry, leadership and teaching">
    {experience.map((e) => <EntryCard entry={e} />)}
    {leadership.map((e) => <EntryCard entry={e} compact detailsHref={`${base}about/#${e.id}`} />)}
  </Section>

  <Section id="work" title="Selected work" kicker="Research, open source and hackathons">
    <div class="featured">
      {
        featured.map((e) => (
          <a class="feat" href={`${base}projects/#${e.id}`}>
            <p class="feat-org">
              {e.org}
              {e.badge && <span class="badge">{e.badge}</span>}
            </p>
            <h3>{e.title}</h3>
            <p class="feat-sum">{e.summary}</p>
            <ul class="feat-tags">
              {e.tags?.slice(0, 3).map((t) => <li>{t}</li>)}
            </ul>
          </a>
        ))
      }
    </div>
    <a class="more" href={`${base}projects/`}>All projects & research <Icon name="arrow" /></a>
  </Section>

  <Section id="education" title="Education">
    {education.map((e) => <EntryCard entry={e} />)}
  </Section>

  <Section id="skills" title="Skills">
    <dl class="skills">
      {
        skills.map((s) => (
          <div>
            <dt>{s.group}</dt>
            <dd>
              <ul>
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section id="contact" title="Let’s talk" kicker="Hiring? Email is the fastest way to reach me.">
    <div class="contact">
      <div class="open-cards">
        {
          openTo.map((o, i) => (
            <div class="open-card">
              <Icon name={i === 0 ? 'clock' : 'globe'} />
              <h3>{o.title}</h3>
              <p>{o.detail}</p>
            </div>
          ))
        }
      </div>
      <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
      <div class="actions">
        <a class="btn" href={`${base}${profile.cvFile}`} download><Icon name="download" /> Download CV</a>
        <a class="btn" href={profile.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" /> LinkedIn</a>
        <a class="btn" href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" /> GitHub</a>
      </div>
    </div>
  </Section>
</Base>

<style>
  .hero {
    padding: 3rem 0 4rem;
  }

  .hero-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero {
      padding: 4.5rem 0 4.5rem;
    }
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .eyebrow :global(svg),
  .open :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }

  h1 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.75rem, 7.5vw, 5rem);
    letter-spacing: -0.02em;
    line-height: 1;
    margin-top: 0.75rem;
  }

  .role {
    margin-top: 1rem;
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    font-weight: 600;
  }

  .role span {
    color: var(--accent);
    font-weight: 500;
  }

  .pitch {
    margin-top: 1rem;
    max-width: 34rem;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .open {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .open li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.85rem;
    font-weight: 500;
  }

  .open li :global(svg) {
    color: var(--accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .btn.icon {
    padding: 0.6rem;
  }

  @media (max-width: 420px) {
    .actions {
      gap: 0.4rem;
    }
    .actions .btn:not(.icon) {
      padding: 0.6rem 0.85rem;
    }
    .wide {
      display: none;
    }
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 4rem 0 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  @media (min-width: 720px) {
    .highlights {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .highlights div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.2rem;
    padding: 1.25rem;
    background: var(--surface);
  }

  .highlights dt {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .highlights dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2.2rem;
    line-height: 1;
  }

  .featured {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .featured {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .feat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.35rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }

  .feat:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .feat-org {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .feat h3 {
    font-size: 1.05rem;
  }

  .feat-sum {
    color: var(--muted);
    font-size: 0.9rem;
    flex: 1;
  }

  .feat-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
  }

  .feat-tags li {
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: var(--accent-soft);
    font-size: 0.75rem;
  }

  .badge {
    margin-left: 0.5rem;
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: var(--badge-soft);
    color: var(--badge);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 500;
    font-size: 0.95rem;
    justify-self: start;
  }

  .more :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .skills {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .skills dt {
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .skills dd {
    margin: 0;
  }

  .skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skills li {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.85rem;
  }

  .skills li::first-letter {
    text-transform: uppercase;
  }

  .contact {
    display: grid;
    gap: 1.5rem;
  }

  .open-cards {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .open-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .open-card {
    padding: 1.25rem 1.35rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .open-card :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--accent);
  }

  .open-card h3 {
    font-size: 1.05rem;
    margin-top: 0.6rem;
  }

  .open-card p {
    color: var(--muted);
    font-size: 0.92rem;
    margin-top: 0.3rem;
  }

  .email {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 6vw, 2.6rem);
    line-height: 1.1;
    word-break: break-all;
  }
</style>
